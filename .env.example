# Copy to .env.local and fill in from Supabase: Project Settings > API (or Data API).
# Without these the plan is saved in the browser only.
VITE_SUPABASE_URL=https://your-project.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Never the secret or
# service_role key: this one ends up in the page.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: which plan (row of the plans table) this app works on. Defaults to "main".
# VITE_PLAN_ID=main
